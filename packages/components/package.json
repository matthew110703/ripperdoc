{
  "name": "@ripperdoc-chrome77/components",
  "version": "1.0.0",
  "description": "Accessible, generic UI components for Ripperdoc design system",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ripperdoc-chrome77/tokens": "workspace:*",
    "@ripperdoc-chrome77/themes": "workspace:*",
    "@ripperdoc-chrome77/utils": "workspace:*",
    "class-variance-authority": "^0.7.1"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  }
}
