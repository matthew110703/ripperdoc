{
  "name": "@ripperdoc-chrome77/themes",
  "version": "1.0.0",
  "description": "Theme specifications (Obsidian & Luminous) and ThemeProvider for Ripperdoc",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./obsidian.css": "./src/obsidian.css",
    "./luminous.css": "./src/luminous.css"
  },
  "files": [
    "dist",
    "src/obsidian.css",
    "src/luminous.css",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  }
}
