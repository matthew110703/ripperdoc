{
  "name": "@ripperdoc/ui",
  "version": "0.1.0",
  "description": "Modern React UI Kit supporting Next.js, built with Storybook and Vite",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm storybook",
    "dev:packages": "pnpm -r --filter \"./packages/*\" --parallel dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "node ./scripts/build.mjs",
    "build:packages": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r exec tsc --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "rimraf --glob packages/*/dist dist storybook-static .next node_modules/.cache",
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@chromatic-com/storybook": "latest",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "latest",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.6.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "latest",
    "vitest": "latest"
  }
}
