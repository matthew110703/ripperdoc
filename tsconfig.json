{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@ripperdoc-chrome77/tokens": ["./packages/tokens/src/index.ts"],
      "@ripperdoc-chrome77/tokens/*": ["./packages/tokens/src/*"],
      "@ripperdoc-chrome77/themes": ["./packages/themes/src/index.ts"],
      "@ripperdoc-chrome77/themes/*": ["./packages/themes/src/*"],
      "@ripperdoc-chrome77/utils": ["./packages/utils/src/index.ts"],
      "@ripperdoc-chrome77/utils/*": ["./packages/utils/src/*"],
      "@ripperdoc-chrome77/components": ["./packages/components/src/index.ts"],
      "@ripperdoc-chrome77/components/*": ["./packages/components/src/*"],
      "@ripperdoc/tokens": ["./packages/tokens/src/index.ts"],
      "@ripperdoc/tokens/*": ["./packages/tokens/src/*"],
      "@ripperdoc/themes": ["./packages/themes/src/index.ts"],
      "@ripperdoc/themes/*": ["./packages/themes/src/*"],
      "@ripperdoc/utils": ["./packages/utils/src/index.ts"],
      "@ripperdoc/utils/*": ["./packages/utils/src/*"],
      "@ripperdoc/components": ["./packages/components/src/index.ts"],
      "@ripperdoc/components/*": ["./packages/components/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".storybook/**/*"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
